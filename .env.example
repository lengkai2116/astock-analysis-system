# ============================================
# A股分析系统 - 环境变量模板
# 复制为 .env 并填入实际值即可使用
# ============================================

# --- LLM 配置 (AI 分析) ---
# 可选值: deepseek / lm_studio / mock (默认 mock)
LLM_PROVIDER=mock
# DeepSeek API 配置 (LLM_PROVIDER=deepseek 时需要)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat-v4
# LM Studio 本地大模型 (LLM_PROVIDER=lm_studio 时需要)
# LM_STUDIO_ENDPOINT=http://localhost:1234/v1
# LM_STUDIO_MODEL=local-model

# --- 数据源 ---
# Tushare Token (用于获取股票数据, 可选)
TUSHARE_TOKEN=your-tushare-token-here

# --- 安全 ---
SECRET_KEY=change-this-to-a-random-string
# API 认证 Token（留空则不启用鉴权）
AUTH_TOKEN=
# CORS 允许的来源（生产环境应设为具体域名）
CORS_ORIGIN=http://localhost:5001

# --- 缓存 ---
# Redis 已不再需要，使用 cachetools.TTLCache 作为内存缓存
# 无需任何额外配置

# --- 数据库 ---
# 生产环境：SQLite 数据库路径（默认由启动脚本自动设置）
# 开发环境：可直接使用项目 data/ 目录
DATABASE_URL=sqlite:///data/app.db
# 数据文件目录（默认值因平台而异）
# macOS: ~/Library/Application Support/Astock/
# Windows: %APPDATA%/Astock/
# 开发时可用项目 data/ 目录
DATA_DIR=./data

# --- QMT 配置（可选，需要额外安装 miniQMT）---
# 启用后注册为最高优先级数据源 (priority=-2)
QMT_ENABLED=false
# miniQMT 账户 ID
QMT_ACCOUNT_ID=
